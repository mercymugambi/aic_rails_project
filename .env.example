# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection settings for development and test.
# Use the port of the PostgreSQL server you run the app against (pgAdmin > server > Properties > Connection).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password
DATABASE_NAME=aic_backed_app
DATABASE_TEST_NAME=aic_backed_app_test

# Super admin account (see db/seeds.rb).
admin_email=admin@example.com
admin_password=admin_password

# Secret used to sign login tokens. Generate one with: bin/rails secret
DEVISE_JWT_SECRET_KEY=replace_with_output_of_bin_rails_secret

# M-Pesa (Daraja) STK Push settings used by Api::V1::PaymentsController.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PAYBILL_SHORTCODE=
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
CALLBACK_URL=https://your-domain.com/mpesa/callback

# Optional: set this when using Redis for Action Cable.
# REDIS_URL=redis://localhost:6379/1
